{
  "name": "xroiq-whiteboard",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.5.3",
  "resolutions": {
    "@supabase/auth-helpers-nextjs": "0.9.0",
    "@supabase/auth-helpers-react": "0.4.0"
  },
  "scripts": {
    "dev": "next dev apps/web -p 3000",
    "build": "next build apps/web",
    "check:auth": "node scripts/assert-invite-only-auth.js",
    "start": "next start apps/web -p 3000",
    "supabase:start": "supabase start",
    "worker": "tsx workers/$npm_config_worker/index.ts",
    "worker:*": "tsx workers/$npm_config_worker/index.ts",
    "worker:ingest": "tsx workers/ingestion/index.ts",
    "worker:ingestion": "tsx workers/ingestion/index.ts",
    "worker:signal": "tsx workers/signal/index.ts",
    "worker:moment": "tsx workers/moment/index.ts",
    "worker:dedupe": "tsx workers/dedupe/index.ts",
    "worker:classify": "tsx workers/classify/index.ts",
    "worker:thread": "tsx workers/thread/index.ts",
    "worker:priority": "tsx workers/priority/index.ts",
    "worker:arc": "tsx workers/arc/index.ts",
    "worker:memory": "tsx workers/memory/index.ts",
    "worker:surfacer": "tsx workers/surfacer/index.ts",
    "dev:workers": "concurrently -k \"pnpm worker --worker=ingestion\" \"pnpm worker --worker=dedupe\" \"pnpm worker --worker=classify\" \"pnpm worker --worker=memory\" \"pnpm worker --worker=surfacer\" \"pnpm worker --worker=signal\" \"pnpm worker --worker=moment\" \"pnpm worker --worker=thread\" \"pnpm worker --worker=priority\" \"pnpm worker --worker=arc\"",
    "prisma:migrate": "prisma migrate dev --name init"
  },
  "dependencies": {
    "@prisma/client": "5.9.0",
    "@supabase/auth-helpers-react": "0.4.0",
    "@supabase/supabase-js": "^2.108.1",
    "adm-zip": "^0.5.17",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "formidable": "3.5.4",
    "json2csv": "6.0.0-alpha.2",
    "lucide-react": "^1.17.0",
    "next": "16.2.9",
    "openai": "4.0.0",
    "pdf-parse": "1.1.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "swr": "2.4.1",
    "tailwind-merge": "^3.6.0",
    "zustand": "4.4.1"
  },
  "devDependencies": {
    "@supabase/auth-helpers-nextjs": "0.9.0",
    "@types/adm-zip": "^0.5.8",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.43",
    "@types/react": "19.2.17",
    "autoprefixer": "10.5.0",
    "concurrently": "10.0.3",
    "jest": "^29.7.0",
    "postcss": "8.5.15",
    "prisma": "5.9.0",
    "supabase": "^2.106.0",
    "tailwindcss": "3.4.19",
    "ts-jest": "^29.4.11",
    "ts-node": "10.9.2",
    "tsx": "4.22.4",
    "typescript": "5.5.2"
  }
}

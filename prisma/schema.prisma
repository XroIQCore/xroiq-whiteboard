
datasource db {
  provider     = "postgresql"
  url      = env("DATABASE_URL")
  relationMode = "prisma"
}

generator client {
  provider = "prisma-client-js"
}

enum CategoryEnum {
  operating_system @map("operating-system")
  framework
  design
  task
  note
  junk

  @@map("category_enum")
}

model File {
  id          String   @id @default(cuid())
  owner       String   @default("unassigned")
  name        String
  type        String
  size        Int
  hash        String
  storagePath String
  rawText     String?  @map("raw_text")
  category    CategoryEnum?
  subBucket   String?  @map("sub_bucket")
  needsAttention Boolean @default(false) @map("needs_attention")
  duplicateOf String?  @map("duplicate_of")
  summary     String?
  status      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt @map("updated_at")

  ExtractedContent ExtractedContent[]
  evidences        MomentEvidence[]
  duplicateSource  File?          @relation("FileDuplicate", fields: [duplicateOf], references: [id], onDelete: Restrict, onUpdate: Restrict)
  duplicates       File[]         @relation("FileDuplicate")
  vector           FileVector?
  memoryEntries    MemoryEntry[]
  reviewLogs       ReviewLog[]

  @@index([owner, category])
  @@index([duplicateOf])
}

model FileVector {
  id   String @id
  file File   @relation(fields: [id], references: [id], onDelete: Cascade)
  vec  Unsupported("vector")

  @@map("file_vector")
}

model ExtractedContent {
  id         String  @id @default(cuid())
  file       File    @relation(fields: [fileId], references: [id], onDelete: Cascade)
  fileId     String
  content    String
  storagePath String?
  confidence Float
  createdAt  DateTime @default(now())

  signals    Signal[]
}

model Signal {
  id          String   @id @default(cuid())
  extractedContent ExtractedContent @relation(fields: [extractedContentId], references: [id], onDelete: Cascade)
  extractedContentId String
  content     String
  confidence  Float
  status      String
  createdAt   DateTime @default(now())

  MomentEvidence MomentEvidence[]
}

model Moment {
  id          String   @id @default(cuid())
  owner       String   @default("unassigned")
  threadId    String?
  title       String?
  context     String
  intention   String?
  need        String?
  state       String
  consent     String
  outcome     String?
  confidence  Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  evidence    MomentEvidence[]
  priority    Priority?

  @@index([owner, intention])
  @@index([threadId])
}

model MomentEvidence {
  id        String  @id @default(cuid())
  moment    Moment  @relation(fields: [momentId], references: [id], onDelete: Cascade)
  momentId  String

  signal    Signal  @relation(fields: [signalId], references: [id], onDelete: Cascade)
  signalId  String

  file      File?   @relation(fields: [fileId], references: [id])
  fileId    String?
}

model ReviewQueue {
  id         String   @id @default(cuid())
  objectType String
  objectId   String
  reason     String
  status     String
  createdAt  DateTime @default(now())
}

model ReviewLog {
  id        String   @id @default(cuid())
  file      File?    @relation(fields: [fileId], references: [id], onDelete: SetNull)
  fileId    String?  @map("file_id")
  userId    String   @map("user_id")
  action    String
  ts        DateTime @default(now())

  @@map("review_log")
  @@index([fileId])
  @@index([userId])
}

model UserPref {
  id        String   @id
  prefs     Json     @default("{}")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("user_prefs")
}

model DuplicateGroup {
  id         String   @id @default(cuid())
  confidence Float
  createdAt  DateTime @default(now())

  items      DuplicateItem[]
}

model DuplicateItem {
  id        String   @id @default(cuid())
  group     DuplicateGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId   String
  objectType String
  objectId  String
}

model User {
  id        String   @id
  email     String   @unique
  role      String   @default("operator")
  createdAt DateTime @default(now())

  @@map("users")
}

model AuditLog {
  id         String   @id @default(cuid())
  actor      String?
  event      String
  objectType String
  objectId   String?
  payload    Json?
  createdAt  DateTime @default(now())

  @@map("audit_log")
  @@index([event])
  @@index([createdAt])
}

model Priority {
  id        String   @id @default(cuid())
  moment    Moment   @relation(fields: [momentId], references: [id], onDelete: Cascade)
  momentId  String   @unique
  rank      Int
  bucket    String
  reason    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("priorities")
  @@index([bucket, rank])
}

model Arc {
  id         String      @id @default(cuid())
  owner      String
  title      String
  summary    String
  confidence Float
  status     String
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  threads    ArcThread[]
  memoryEntries MemoryEntry[]

  @@map("arcs")
  @@index([owner, status])
}

model MemoryEntry {
  id         String   @id @default(cuid())
  sourceFile File     @relation(fields: [sourceFileId], references: [id], onDelete: Cascade)
  sourceFileId String @unique @map("source_file")
  arc        Arc?     @relation(fields: [arcId], references: [id], onDelete: SetNull)
  arcId      String?  @map("arc_id")
  summary    String?
  keywords   String[] @default([])
  confidence Float
  status     String   @default("active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("memory_entries")
  @@index([arcId])
  @@index([status])
}

model ArcThread {
  id        String   @id @default(cuid())
  arc       Arc      @relation(fields: [arcId], references: [id], onDelete: Cascade)
  arcId     String
  threadId  String
  createdAt DateTime @default(now())

  @@map("arc_thread")
  @@unique([arcId, threadId])
  @@index([threadId])
}

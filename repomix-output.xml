  try {
    const supabase = getSupabaseAdmin();
    await supabase.channel("whiteboard_counts").send({
      type: "broadcast",
      event,
      payload,
    });
  } catch (error) {
    console.warn(`[realtime] ${event} broadcast skipped`, error);
  }
}
